# ── OpenRouter (LLM — REQUIRED) ─────────────────────────────────────
# Get your key at: openrouter.ai → Keys (free signup)
# Supports: anthropic/claude-opus-4-5, openai/gpt-4o, google/gemini-pro-1.5, etc.
OPENROUTER_API_KEY=sk-or-...

# Model to use via OpenRouter (default: Claude via Anthropic)
OPENROUTER_MODEL=anthropic/claude-opus-4-5

# ── Breeth (session memory — hackathon free access) ──────────────────
# Get your key at: thebreeth.com/app → API Keys
# Leave empty to use in-memory storage (works fine for local demo)
BREETH_API_KEY=ck_live_...
BREETH_PROJECT_ID=interview-agent
